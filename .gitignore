# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/

# ── Тесты и покрытие ──────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Логи ──────────────────────────────────────────────────────────────────
*.log
logs/
.logs/
*.out.log
*.err.log

# ── Конфигурация (п.44, п.61: секреты не в репозитории) ───────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Данные и документы дел ────────────────────────────────────────────────
# Материалы дел не должны попадать в репозиторий: это персональные данные.
data/cases/
!data/cases/.gitkeep
data/demo/generated/
uploads/
*.pdf
*.docx
# Отчёты проекта — служебные документы, в отличие от материалов дел
!docs/report-mvp.docx
!docs/for-rector.docx

# Служебные файлы перенаправления вывода при фоновых прогонах демо
backend/.demo*.out
backend/.demo*.err
backend/.ui*.out
backend/.ui*.err
backend/.e2e*.out
backend/.e2e*.err
*.sqlite
*.db
*.db-wal
*.db-shm

# ── Frontend ──────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
npm-debug.log*
yarn-error.log*

# ── IDE и ОС ──────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Прочее ────────────────────────────────────────────────────────────────
*.tmp
*.bak
.qmd/
.claude/settings.local.json

# Результат прошлого прогона демо: бэкап, который не нужен в репозитории
data/demo/output/.previous/

# Обезличенное реальное решение: лицензия корпуса не разрешает публикацию
data/demo/real/

# Обезличенное реальное судебное решение: только для локального стенда.
# Лицензия корпуса решений не дает права публиковать его фрагменты,
# поэтому в репозиторий оно не попадает.
data/demo/real/

# Оценочная ведомость юриста (scripts/eval_harness.py): содержит фрагменты
# материалов и решений дела — по тем же правилам, что и data/demo/real/.
data/eval/

# Обучающая выборка, собранная из решений корпуса. Файлы производные
# от реальных решений, поэтому под тем же правилом: в репозиторий не
# попадают. Сама выборка и отчёт о её составе остаются на машине.
data/lora/

# Индекс резолютивных частей корпуса: производный от реальных решений
# и сам корпус весом в гигабайты. На машине остаётся, в репозиторий не
# попадает.
data/corpus_index/
data/corpus_index_full/
data/index_smoke/
data/index_smoke2/
