Зонды и выгрузки прогонов накопились за два раунда ревью; untracked-мусор в рабочем дереве - риск случайно унести его в публичный снимок. Правило в .gitignore, файлы по-прежнему лежат на машине.
---
 .gitignore | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/.gitignore b/.gitignore
index fa8f03f..0fa76a6 100644
--- a/.gitignore
+++ b/.gitignore
@@ -97,6 +97,11 @@ data/demo/real/
 # материалов и решений дела — по тем же правилам, что и data/demo/real/.
 data/eval/
 
+# Временные файлы проверок (scripts/tmp_*): зонды, выгрузки, отчёты
+# прогонов. В репозиторий не идут — иначе случайный коммит уносит
+# в публичный снимок отладочный мусор.
+scripts/tmp_*
+
 # Архив гипотез QD-Court (Этапы 4-6 ТЗ): рабочие данные поиска,
 # в репозиторий не входят.
 data/exploration/
