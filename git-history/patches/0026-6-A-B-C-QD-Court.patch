diff --git a/docs/qd-court-evaluation.md b/docs/qd-court-evaluation.md
new file mode 100644
index 0000000..83462bd
--- /dev/null
+++ b/docs/qd-court-evaluation.md
@@ -0,0 +1,72 @@
+# Оценка QD-Court: режимы A/B/C (Этап 6 ТЗ)
+
+Дата: 2026-10-20. Скрипт: `scripts/qd_court_eval.py` (воспроизводим:
+`backend\.venv\Scripts\python.exe scripts\qd_court_eval.py`). Одинаковые
+входные материалы (10 дел демо-набора), один предлагающий и один
+проверяющий, сопоставимый бюджет (`ExplorationBudget()` по умолчанию).
+
+## Режимы
+
+- **A** — существующий конвейер без поиска: новых направлений 0
+  (базлайн; метрики покрытия — из Этапа 2).
+- **B** — генерация направлений без архива: `explore()` + `verify()`,
+  без новизны, без сохранения, без мутаций.
+- **C** — QD-Court: архив, novelty-first admission, мутации, локальная
+  конкуренция.
+
+## Результаты
+
+| Дело | B: предложено | B: подтверждено | C: гипотез всего | C: подтверждено | C: повторов отклонено | C: итераций |
+|---|---|---|---|---|---|---|
+| real-01 | 3 | 3 | 5 | 3 | 0 | 5 |
+| real-02 | 0 | 0 | 0 | 0 | 0 | 0 |
+| real-03 | 2 | 2 | 4 | 2 | 0 | 4 |
+| real-04 | 4 | 4 | 5 | 2 | 2 | 5 |
+| real-05 | 3 | 3 | 5 | 3 | 0 | 5 |
+| real-06 | 2 | 2 | 4 | 2 | 0 | 4 |
+| real-07 | 1 | 1 | 2 | 1 | 0 | 2 |
+| real-08 | 1 | 1 | 2 | 1 | 0 | 2 |
+| real-09 | 0 | 0 | 0 | 0 | 0 | 0 |
+| real-10 | 0 | 0 | 0 | 0 | 0 | 0 |
+| **ИТОГО** | **16** | **16** | **27** | **14** | **2** | **27** |
+
+В C дополнительно 11 гипотез со статусом SUPERSEDED — это родители,
+замещённые потомками-мутациями (уточнение направления фрагментом того же
+источника). Все 27 подтверждённых/сохранённых записей имеют проверенные
+основания: источник существует в материалах, числа взяты из материалов.
+
+## Что видно из сравнения
+
+1. **Фильтр повторов работает:** в B реальных дублей нет (каждое направление
+   уникально в рамках прогона), но без архива повторный прогон добавлял бы
+   те же направления снова. В C повторный прогон не раздувает архив
+   (тест `test_repeated_run_does_not_grow_archive`).
+2. **Новизна отсекает близкие формулировки:** real-04 — 4 предложенных
+   против 2 подтверждённых: два схожих довода объединены фильтром
+   (второй оставлен в архиве как REJECTED с причиной). Это и польза
+   (без дублей), и риск (различный смысл под похожими словами может быть
+   отсечён) — см. ограничения.
+3. **Мутации уточняют, а не плодят:** 11 родителей замещены потомками
+   с дополнительным фрагментом источника; счётчик подтверждённых при
+   этом сохраняется.
+4. **Отказов нет:** fallback 0 на 10 делах; пустой пакет и сломанный
+   архив покрыты тестами (`test_no_crash_on_empty_pack`,
+   `test_fallback_on_broken_archive`).
+5. **Три дела без направлений** (real-02, real-09, real-10): в материалах
+   нет возражений, противоречий сумм, лишних норм и вопросов квалификации.
+   Молчание здесь честное, а не сбой.
+
+## Ограничения (честно)
+
+- Метрики **технические**: полнота покрытия и полезность направлений
+  юристом не размечались. Юридического превосходства C над B **не
+  утверждается** — для этого нужна независимая юридическая разметка.
+- `contradiction_amounts` срабатывает на любой многосуммной заявке
+  (точность сигнала низкая — это направление к проверке, а не факт
+  противоречия).
+- Предлагающий — правила проекта, без модели; формулировки примитивны,
+  разнообразие ограничено пятью видами направлений.
+- Режим A не измерялся как «поиск»: у него нет гипотез по определению,
+  его метрики — из Этапа 2 (покрытие доводов, замечания проверки).
+- Бандит и автооптимизация стратегии не внедрялись (ТЗ: сначала сравнить
+  простой поиск и эволюционный архив — выполнено).
diff --git a/scripts/qd_court_eval.py b/scripts/qd_court_eval.py
new file mode 100644
index 0000000..f76bd07
--- /dev/null
+++ b/scripts/qd_court_eval.py
@@ -0,0 +1,105 @@
+"""Сравнение режимов A/B/C QD-Court (Этап 6 ТЗ).
+
+A — существующий конвейер без поиска (базлайн: новых направлений 0).
+B — генерация направлений без архива: explore + verify, без новизны и
+    сохранения (повторы возможны).
+C — QD-Court: архив, мутации, novelty-first admission.
+
+Одинаковые входные материалы, одинаковый предлагающий и проверяющий,
+сопоставимый бюджет. Метрики технические: юридическую полезность без
+разметки человека не утверждаем.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+CASES = ROOT / "data" / "demo" / "real" / "cases"
+EVAL_ROOT = ROOT / "data" / "exploration" / "_eval"
+OUT = Path(__file__).with_name("tmp_qd_eval_out.txt")
+
+def _load(name: str, filename: str):
+    spec = importlib.util.spec_from_file_location(name, ROOT / "scripts" / filename)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def main() -> None:
+    import shutil
+
+    shutil.rmtree(EVAL_ROOT, ignore_errors=True)  # свежий архив на каждый прогон
+    build = _load("qde_build_real_site", "build_real_site.py")
+    from app.exploration import ExplorationBudget, ExplorationService
+    from app.exploration.proposer import DirectionProposer
+    from app.exploration.verification import HypothesisVerifier
+
+    proposer = DirectionProposer()
+    verifier = HypothesisVerifier()
+    index = json.loads((CASES / "index.json").read_text(encoding="utf-8"))
+
+    lines = [
+        "СРАВНЕНИЕ РЕЖИМОВ A/B/C",
+        "A = конвейер без поиска (базлайн, новых направлений 0)",
+        "",
+        "дело | B: предл. | B: подтв. | C: гипотез | C: подтв. | C: повторов | C: итер.",
+    ]
+    totals = {"b_candidates": 0, "b_supported": 0, "c_all": 0, "c_supported": 0,
+              "c_rejected": 0, "c_iterations": 0, "fallbacks": 0}
+
+    for entry in index["cases"]:
+        slug = entry["slug"]
+        case_dir = CASES / slug
+        settings = build.make_settings(case_dir)
+        settings.ensure_dirs()
+        pack = build.build_pack(case_dir, settings)
+
+        # Режим B: без архива и новизны
+        candidates = proposer.explore(pack)
+        verified_b = [verifier.verify(c, pack) for c in candidates]
+        b_supported = sum(1 for h in verified_b if h.status.value == "SUPPORTED")
+
+        # Режим C: полный сервис с архивом
+        service = ExplorationService(EVAL_ROOT, ExplorationBudget())
+        report = service.run(slug, pack)
+        c_supported = sum(
+            1 for h in report.hypotheses if h.status.value == "SUPPORTED"
+        )
+        c_rejected = sum(
+            1 for h in report.hypotheses if h.status.value == "REJECTED"
+        )
+        if report.fallback:
+            totals["fallbacks"] += 1
+
+        totals["b_candidates"] += len(candidates)
+        totals["b_supported"] += b_supported
+        totals["c_all"] += len(report.hypotheses)
+        totals["c_supported"] += c_supported
+        totals["c_rejected"] += c_rejected
+        totals["c_iterations"] += report.iterations
+
+        lines.append(
+            f"{slug} | {len(candidates)} | {b_supported} | "
+            f"{len(report.hypotheses)} | {c_supported} | {c_rejected} | "
+            f"{report.iterations}"
+        )
+
+    lines += [
+        "",
+        f"ИТОГО B: предложено {totals['b_candidates']}, "
+        f"подтверждено {totals['b_supported']}",
+        f"ИТОГО C: гипотез {totals['c_all']}, подтверждено "
+        f"{totals['c_supported']}, отклонено-повторов {totals['c_rejected']}, "
+        f"итераций {totals['c_iterations']}, fallback {totals['fallbacks']}",
+    ]
+    OUT.write_text("\n".join(lines), encoding="utf-8")
+    print("eval ok")
+
+
+if __name__ == "__main__":
+    main()
