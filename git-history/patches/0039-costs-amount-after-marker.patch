В протоколе real-04 в одной фразе перечислены и неустойка 10 564,40, и затраты на проведение экспертизы 3 000 - 'иные расходы' брали первую сумму и показывали неустойку. Теперь сумма ищется после признака расходов, а форма 'затраты на проведение экспертизы' добавлена в COSTS_PATTERN: real-04 показывает 3 000. +1 тест, suite 751/0, ruff, mypy чисто.
---
 backend/app/drafting/requirements.py  | 15 ++++++++++----
 backend/tests/test_review_findings.py | 29 +++++++++++++++++++++++++++
 docs/end-to-end-evaluation.md         |  6 ++++++
 3 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/backend/app/drafting/requirements.py b/backend/app/drafting/requirements.py
index a63e317..ecce277 100644
--- a/backend/app/drafting/requirements.py
+++ b/backend/app/drafting/requirements.py
@@ -79,7 +79,8 @@ FEE_PATTERNS = [
 # Иные расходы по ст. 100 ГПК РФ.
 COSTS_PATTERN = re.compile(
     r"(?:иные\s+расход\w*|расход\w*\s+на\s+(?:поездк|почтов\w+|\S+_ expert)"
-    r"|экспертиз\w*\s+и|расход\w*\s+на\s+оплат\w*\s+экспертиз\w*)",
+    r"|экспертиз\w*\s+и|расход\w*\s+на\s+оплат\w*\s+экспертиз\w*)"
+    r"|затрат\w*\s+на\s+проведение\s+экспертиз\w*",
     re.I,
 )
 
@@ -316,11 +317,17 @@ def _fee_from(items: list[EvidenceItem]) -> int | None:
 
 
 def _costs_from(items: list[EvidenceItem]) -> int | None:
-    """Иные расходы из материалов дела."""
+    """Иные расходы из материалов дела.
+
+    Сумма берётся после признака расходов, а не первая в предложении:
+    в одной фразе протокола перечислены и неустойка, и затраты на
+    экспертизу, и первой стоит неустойка.
+    """
     for item in items:
-        if not COSTS_PATTERN.search(item.text):
+        marker = COSTS_PATTERN.search(item.text)
+        if marker is None:
             continue
-        value = _find_amount(item.text)
+        value = _find_amount(item.text[marker.end():])
         if value and 1_000 < value < 1_000_000_000:
             return value
     return None
diff --git a/backend/tests/test_review_findings.py b/backend/tests/test_review_findings.py
index a818bca..7267d72 100644
--- a/backend/tests/test_review_findings.py
+++ b/backend/tests/test_review_findings.py
@@ -187,6 +187,35 @@ class TestConflictNoteDetails:
         assert len(notes) == 1, unrecognised
 
 
+class TestCostsAmountBelongsToMarker:
+    """Сумма иных расходов — та, что стоит после признака расходов.
+
+    В протоколе real-04 в одной фразе перечислены и неустойка
+    (10 564,40), и затраты на проведение экспертизы (3 000). Первой
+    стоит неустойка, и «иные расходы» без привязки к признаку
+    показывали 10 564.
+    """
+
+    def test_costs_taken_after_marker(self) -> None:
+        from app.drafting.requirements import extract_fee_and_costs
+
+        pack = EvidencePack(case_number="T-REVIEW")
+        pack.items.append(
+            EvidenceItem(
+                category="claims",
+                text=(
+                    "Просит взыскать неустойку 10564 рубля 40 копеек, "
+                    "затраты на проведение экспертизы в сумме 3000 рублей."
+                ),
+                source_document="05_protocol.txt",
+                source_type="CLAIM",
+                order=1,
+            )
+        )
+        _fee, costs = extract_fee_and_costs(pack)
+        assert costs == 3000
+
+
 class TestAmountSpelledOutInBrackets:
     def test_sum_with_words_in_brackets(self) -> None:
         # D5: «15 191 (Пятнадцать тысяч сто девяносто один) рубль
diff --git a/docs/end-to-end-evaluation.md b/docs/end-to-end-evaluation.md
index 4aa7331..53db9f8 100644
--- a/docs/end-to-end-evaluation.md
+++ b/docs/end-to-end-evaluation.md
@@ -113,6 +113,12 @@ real-08 в проекте — сумма иска (10 400), суд удовле
 | real-05 | 1 000 | **41 381** | моральный вред 10 000, убытки 20 921,53 и неустойка 10 460,76 (протокол — требования истца; суммы прописью в скобках) |
 | real-06 | 0 | **25 890** | неустойка 6 890, моральный вред 7 000, убытки (кредит) 3 000, расходы на юридические услуги и представительство 9 000 (протокол) |
 
+Отдельно поправлены иные расходы по ст. 100 ГПК РФ: сумма берётся
+после признака расходов, а не первая в предложении — в протоколе
+real-04 в одной фразе стоят и неустойка 10 564,40, и затраты на
+проведение экспертизы 3 000, и первой шла неустойка. Теперь «иные
+расходы» real-04 — 3 000.
+
 Остальные шесть дел не изменились. «Итог системы» теперь означает сумму
 **всех** извлечённых требований, а не одного пункта, — это следствие
 того, что система научилась видеть перечисления.
