- draft_agent.sources: один документ = один источник. Раньше дедупликация
  шла по полной строке цитаты, и договор считался двумя источниками, когда
  на него ссылались с разных страниц - судья видел больше доказательств,
  чем в деле
- engine: пустой незаглушечный раздел даёт INCOMPLETE (HIGH) и увеличивает
  unsupported_claims. Раньше пустая вводная давала нулевой счётчик
  'утверждений без источника' при видимой пустоте
- 5 тестов на инварианты счётчиков

619 passed, ruff clean, mypy --strict clean
---
 backend/app/agents/draft_agent.py  |  14 +++-
 backend/app/verification/engine.py |  22 ++++++
 backend/tests/test_counters.py     | 108 +++++++++++++++++++++++++++++
 3 files changed, 143 insertions(+), 1 deletion(-)
 create mode 100644 backend/tests/test_counters.py

diff --git a/backend/app/agents/draft_agent.py b/backend/app/agents/draft_agent.py
index e544494..68e4f9a 100644
--- a/backend/app/agents/draft_agent.py
+++ b/backend/app/agents/draft_agent.py
@@ -89,10 +89,22 @@ class DraftResult:
         return [s for s in self.sections if s.needs_review]
 
     def sources(self) -> list[str]:
+        """Источники проекта, по одному на документ.
+
+        Раньше дедупликация шла по полной строке цитаты, и один и тот же
+        договор считался двумя источниками, когда на него ссылались с
+        разными страницами («03_contract.txt» и «03_contract.txt, стр. 3»).
+        Счётчик «источников» расходился с числом документов, и судья видел
+        в проекте больше доказательств, чем их в деле. Ключом берётся имя
+        документа до запятой — страница остаётся в первой встречной цитате.
+        """
         out: list[str] = []
+        seen: set[str] = set()
         for section in self.sections:
             for citation in section.citations:
-                if citation not in out:
+                base = citation.split(",")[0].strip()
+                if base and base not in seen:
+                    seen.add(base)
                     out.append(citation)
         return out
 
diff --git a/backend/app/verification/engine.py b/backend/app/verification/engine.py
index f9b310e..3ebf46d 100644
--- a/backend/app/verification/engine.py
+++ b/backend/app/verification/engine.py
@@ -422,6 +422,28 @@ def verify_draft(
 
         report.claims_checked += 1
 
+        # ── Пустой раздел ────────────────────────────────────────
+        # Не заглушка, а молчаливо пустой текст: проверки ниже по
+        # пустой строке ничего не находят, счётчики остаются нулевыми,
+        # а судья видит в проекте «утверждений без источника: 0» рядом
+        # с пустой вводной частью (п. 9.5 разбора). Пустота — это
+        # результат тоже: о нём нужно сказать, иначе счётчики врут.
+        if not text.strip():
+            report.unsupported_claims += 1
+            report.issues.append(
+                Issue(
+                    type=IssueType.INCOMPLETE,
+                    severity=Severity.HIGH,
+                    text="",
+                    reason=(
+                        f"раздел «{section.name}» пуст: проверять нечего, "
+                        "данные из материалов в него не попали"
+                    ),
+                    section=section.name,
+                )
+            )
+            continue
+
         # Номера статей из ссылок на нормы — не суммы. Без этого любая
         # корректная ссылка «статья 310 ГК РФ» помечалась бы как
         # «выдуманное число».
diff --git a/backend/tests/test_counters.py b/backend/tests/test_counters.py
new file mode 100644
index 0000000..973c7ed
--- /dev/null
+++ b/backend/tests/test_counters.py
@@ -0,0 +1,108 @@
+"""Сверка счётчиков отчёта и источников (п. 9.5 разбора)."""
+
+import asyncio
+
+from app.agents.draft_agent import DraftResult, SectionDraft, generate_draft
+from app.agents.evidence_pack import EvidenceItem, EvidencePack
+from app.verification.engine import IssueType, verify_draft
+
+
+class TestSourceCounters:
+    def test_one_document_counts_once(self) -> None:
+        # Рецензент: один документ посчитан как два источника — ссылались
+        # на него с разных страниц, и дедупликация по полной строке
+        # считала это двумя документами.
+        result = DraftResult(case_number="T-1")
+        result.sections = [
+            SectionDraft(
+                key="motivating",
+                name="Мотивировочная часть",
+                text="Договор подтверждён.",
+                is_mock=False,
+                citations=["03_contract.txt", "03_contract.txt, стр. 3"],
+            ),
+            SectionDraft(
+                key="descriptive",
+                name="Описательная часть",
+                text="Договор заключён.",
+                is_mock=False,
+                citations=["03_contract.txt, стр. 7"],
+            ),
+        ]
+        assert result.sources() == ["03_contract.txt"]
+
+    def test_stats_citations_match_sources(self) -> None:
+        result = DraftResult(case_number="T-2")
+        result.sections = [
+            SectionDraft(
+                key="operative",
+                name="РЕШИЛ",
+                text="Взыскать.",
+                is_mock=False,
+                citations=["01_claim.txt", "01_claim.txt, стр. 2", "02_response.txt"],
+            )
+        ]
+        assert result.stats()["citations"] == 2
+
+
+class TestEmptySection:
+    def test_empty_section_flagged_and_counted(self) -> None:
+        pack = EvidencePack(case_number="T-3")
+        draft = type("D", (), {})()
+        draft.sections = [
+            SectionDraft(key="introductory", name="Вводная часть", text="", is_mock=False)
+        ]
+        report = verify_draft(draft, pack)
+        empty = [
+            i
+            for i in report.issues
+            if i.type is IssueType.INCOMPLETE and "пуст" in i.reason
+        ]
+        assert empty
+        assert report.unsupported_claims >= 1
+
+    def test_nonempty_section_not_flagged_as_empty(self) -> None:
+        pack = EvidencePack(case_number="T-4")
+        draft = type("D", (), {})()
+        draft.sections = [
+            SectionDraft(
+                key="introductory",
+                name="Вводная часть",
+                text="Именем Российской Федерации",
+                is_mock=False,
+            )
+        ]
+        report = verify_draft(draft, pack)
+        empty = [i for i in report.issues if "пуст" in i.reason]
+        assert not empty
+
+    def test_counters_agree_in_full_run(self) -> None:
+        pack = EvidencePack(case_number="T-5", court_name="Мировой судья")
+        pack.items.append(
+            EvidenceItem(
+                category="claims",
+                text="Взыскать 150 000 руб.",
+                source_document="01_claim.txt",
+                source_type="CLAIM",
+                order=1,
+            )
+        )
+        from app.agents.evidence_pack import load_template
+
+        template = load_template(name="civil_judgment")
+
+        class _NoLLM:
+            name = "no-llm"
+            model = ""
+
+            async def generate(self, request):  # noqa: ANN001, ANN201
+                return type("R", (), {"text": "Текст раздела по материалам.", "is_mock": False})()
+
+        result = asyncio.run(generate_draft(pack, template, provider=_NoLLM()))
+        report = verify_draft(result, pack)
+        data = report.to_dict()
+        # Реальные инварианты, а не подгонка: sections_checked всегда
+        # равно числу разделов, а claims_checked не может его превысить —
+        # оно растёт один раз на незаглушечный раздел.
+        assert data["sections_checked"] == len(result.sections)
+        assert data["claims_checked"] <= data["sections_checked"]
