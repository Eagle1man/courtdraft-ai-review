+    ),
     (
         re.compile(r"задолженност\w*|долг", re.I),
         "задолженность по договору",
@@ -284,6 +341,19 @@ CLAIM_BASIS_ANCHORS: list[tuple[re.Pattern[str], str]] = [
         ),
         "возмещение стоимости имущества",
     ),
+    # Та же основа, но в форме, которой суд пишет в мотивировочной
+    # части: «телефон стоимостью 6890 рублей», «автомобиль стоимостью
