+++ b/backend/app/agents/claim_phrases.py
@@ -170,6 +170,32 @@ CLAIM_BASIS_PATTERNS: list[tuple[re.Pattern[str], str]] = [
         ),
         "убытки",
     ),
+    (
+        # Узкие формы — перед общей «задолженность по договору» (порядок
+        # решает, как и в CLAIM_BASIS_ANCHORS ниже): real-01 уточнение
+        # «задолженность по оплате за ремонт и содержание жилья» давало
+        # общий якорь, и пункт слипался с ЖКУ 11 107,84.
+        #
+        # Разбор по пунктам режет окно по «и» и запятым, поэтому после
+        # «задолженность ...» ждётся одно слово из пары «ремонт /
+        # содержание», а не вся пара: фраза «ремонт и содержание»
+        # после разреза доходит куском «задолженность ... за ремонт».
+        re.compile(
+            r"(?:взыска\w+|возмести\w*)\s+" + _BETWEEN
+            + r"задолженност\w*[^.]{0,80}?(?:ремонт|содержани)\w*",
+            re.I,
+        ),
+        "задолженность за ремонт и содержание жилья",
+    ),
+    (
+        re.compile(
+            r"(?:взыска\w+|возмести\w*)\s+" + _BETWEEN
+            + r"задолженност\w*[^.]{0,80}?"
+            r"(?:жилищно-коммунальн\w*|коммунальн\w*\s+услуг)",
+            re.I,
+        ),
+        "задолженность за жилищно-коммунальные услуги",
+    ),
     (
         re.compile(
             r"(?:взыска\w+|возмести\w*)\s+" + _BETWEEN
@@ -190,6 +216,15 @@ CLAIM_BASIS_PATTERNS: list[tuple[re.Pattern[str], str]] = [
         ),
         "возмещение стоимости имущества",
     ),
+    (
+        re.compile(
+            r"(?:товар\w*|телефон\w*|имуществ\w*|вещ\w*|комплект\w*|"
+            r"автомобил\w*|жиль[ея]\w*|квартир\w*|участк\w*)"
+            r"\s+стоимост\w+\s+(?:[\d\s.,]{3,})",
+            re.I,
+        ),
+        "возмещение стоимости имущества",
+    ),
     (
         re.compile(
             r"признать\s+" + _BETWEEN
@@ -272,6 +307,28 @@ CLAIM_BASIS_ANCHORS: list[tuple[re.Pattern[str], str]] = [
         re.compile(r"убытк\w*|реальный\s+ущерб|ущерб", re.I),
         "убытки",
     ),
+    # Узкие якоря стоят ПЕРЕД общим «задолженность по договору»: в
+    # якорях побеждает первое совпадение. В real-01 «задолженность
+    # за жилищно-коммунальные услуги 11 107,84» и уточнение «задолженность
+    # по оплате за ремонт и содержание жилья 7 919,17» схлопывались
+    # в одно основание, и проект требовал выбрать одну из двух сумм
+    # вместо двух пунктов. Суд в итоге отказал по ремонту и взыскал
+    # ЖКУ — но это решение судья принимает сам, а не схлопка в один пункт.
+    (
+        re.compile(
+            r"задолженност\w*[^.]{0,80}?(?:ремонт|содержани)\w*",
