- engine.py: FEE_IN_CLAIM_PRICE (MEDIUM) - 'включая госпошлину',
  'в том числе пошлина', 'с учётом пошлины' в проекте или требованиях:
  цена иска определяется без пошлины (ст. 91), а пошлина - судебный
  расход (ст. 98); завышенная цена искажает расчёт ст. 333.19 НК
- 4 теста
---
 backend/app/verification/engine.py | 42 +++++++++++++++++++
 backend/tests/test_fee_in_price.py | 65 ++++++++++++++++++++++++++++++
 2 files changed, 107 insertions(+)
 create mode 100644 backend/tests/test_fee_in_price.py

diff --git a/backend/app/verification/engine.py b/backend/app/verification/engine.py
index 865f203..f9b310e 100644
--- a/backend/app/verification/engine.py
+++ b/backend/app/verification/engine.py
@@ -51,6 +51,7 @@ class IssueType(StrEnum):
     JURISDICTION_MISMATCH = "JURISDICTION_MISMATCH"
     OBJECTIONS_UNADDRESSED = "OBJECTIONS_UNADDRESSED"
     PRETRIAL_UNADDRESSED = "PRETRIAL_UNADDRESSED"
+    FEE_IN_CLAIM_PRICE = "FEE_IN_CLAIM_PRICE"
 
 
 class Severity(StrEnum):
@@ -168,6 +169,19 @@ _LAW_RE = re.compile(
     re.IGNORECASE,
 )
 
+#: Госпошлина в цене иска: «150 000 руб., включая госпошлину».
+#: Ч. 1 ст. 91 ГПК РФ относит госпошлину к судебным расходам, а не
+#: к цене иска: цена определяется по требованию без пошлины, и
+#: «включая» завышает цену и расчёт пошлины (ст. 333.19 НК РФ).
+#: Между префиксом и «пошлин» допускается до 25 символов: «госпошлину»,
+#: «государственную пошлину», «государственную пошлину (НК РФ)».
+_FEE_IN_PRICE_RE = re.compile(
+    r"включ\w*\s+[^.]{0,25}пошлин"
+    r"|в\s+том\s+числе\s+[^.]{0,25}пошлин"
+    r"|с\s+уч[её]том\s+[^.]{0,25}пошлин",
+    re.IGNORECASE,
+)
+
 
 def _numbers_in(text: str) -> set[str]:
     """Числа в тексте, пригодные для сверки с материалами.
@@ -622,6 +636,34 @@ def verify_draft(
             )
         )
 
+    # ── Госпошлина в цене иска (ч. 1 ст. 91 ГПК РФ) ────────────────
+    # «Цена иска 150 000 руб., включая госпошлину»: пошлина — судебный
+    # расход (ст. 98 ГПК РФ), а не часть цены иска. Завышенная цена
+    # иска искажает расчёт самой пошлины по ст. 333.19 НК РФ, поэтому
+    # ошибка касается и резолютивной части.
+    fee_in_price = _FEE_IN_PRICE_RE.search(draft_text)
+    if fee_in_price is None:
+        for item in pack.by_category("claims"):
+            fee_in_price = _FEE_IN_PRICE_RE.search(item.text)
+            if fee_in_price:
+                break
+    if fee_in_price:
+        matched = fee_in_price.string
+        report.issues.append(
+            Issue(
+                type=IssueType.FEE_IN_CLAIM_PRICE,
+                severity=Severity.MEDIUM,
+                text=matched[
+                    max(0, fee_in_price.start() - 60) : fee_in_price.start() + 80
+                ],
+                reason=(
+                    "госпошлина указана включённой в цену иска: по ч. 1 "
+                    "ст. 91 ГПК РФ цена иска определяется без госпошлины, "
+                    "госпошлина — судебный расход (ст. 98 ГПК РФ)"
+                ),
+            )
+        )
+
     # ── Таблица «обстоятельство — доказательства» ──────────────────
     # Считается по материалам, а не по проекту: она отвечает на вопрос,
     # откуда взято каждое обстоятельство, и её нельзя подделать текстом
diff --git a/backend/tests/test_fee_in_price.py b/backend/tests/test_fee_in_price.py
new file mode 100644
index 0000000..ece2c40
--- /dev/null
+++ b/backend/tests/test_fee_in_price.py
@@ -0,0 +1,65 @@
+"""Госпошлина не входит в цену иска (п. 7 разбора, ч. 1 ст. 91 ГПК РФ)."""
+
+from app.agents.draft_agent import SectionDraft
+from app.agents.evidence_pack import EvidenceItem, EvidencePack
+from app.verification.engine import IssueType, verify_draft
+
+
+def _pack(claim_text: str | None) -> EvidencePack:
+    pack = EvidencePack(case_number="T-0001")
+    if claim_text:
+        pack.items.append(
+            EvidenceItem(
+                category="claims",
+                text=claim_text,
+                source_document="01_claim.txt",
+                source_type="CLAIM",
+                order=1,
+            )
+        )
+    return pack
+
+
+def _draft(text: str):
+    draft_stub = type("D", (), {})()
+    draft_stub.sections = [
+        SectionDraft(key="operative", name="Резолютивная часть", text=text, is_mock=False)
+    ]
+    return draft_stub
+
+
+class TestFeeInClaimPrice:
+    def test_draft_phrase_flagged(self) -> None:
+        report = verify_draft(
+            _draft("Цена иска составляет 150 000 руб., включая госпошлину."),
+            _pack(None),
+        )
+        flagged = [i for i in report.issues if i.type is IssueType.FEE_IN_CLAIM_PRICE]
+        assert flagged
+        assert "ст. 91" in flagged[0].reason
+
+    def test_claim_phrase_flagged(self) -> None:
+        # Ошибка в самом иске: цена иска с пошлиной попадает в расчёт
+        # по ст. 333.19 НК РФ, и судья должен увидеть расхождение.
+        report = verify_draft(
+            _draft("Взыскать с ответчика в пользу истца 155 500 руб."),
+            _pack("Цена иска 155 500 руб., в том числе государственная пошлина."),
+        )
+        flagged = [i for i in report.issues if i.type is IssueType.FEE_IN_CLAIM_PRICE]
+        assert flagged
+
+    def test_clean_price_not_flagged(self) -> None:
+        report = verify_draft(
+            _draft("Взыскать 150 000 руб. Госпошлину взыскать с ответчика."),
+            _pack("Взыскать задолженность 150 000 руб. Пошлина уплачена."),
+        )
+        flagged = [i for i in report.issues if i.type is IssueType.FEE_IN_CLAIM_PRICE]
+        assert not flagged
+
+    def test_with_accounting_uses_flagged(self) -> None:
+        report = verify_draft(
+            _draft("С учётом пошлины цена иска 150 000 руб."),
+            _pack(None),
+        )
+        flagged = [i for i in report.issues if i.type is IssueType.FEE_IN_CLAIM_PRICE]
+        assert flagged
