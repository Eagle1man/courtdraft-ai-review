+
+const DOC_TYPE_TEXT = {
+  CLAIM: "Исковое заявление",
+  RESPONSE: "Отзыв",
+  CONTRACT: "Договор",
+  RECEIPT: "Платёжный документ",
+  ACT: "Акт",
+  EXPERT_OPINION: "Заключение эксперта",
+  EVIDENCE: "Доказательство",
+  MOTION: "Ходатайство",
+  PROTOCOL: "Протокол",
+  OTHER: "Иной документ",
+};
+
+function label(map, key) {
+  return map[key] || key;
+}
