+++ b/backend/app/verification/subject_of_proof.py
@@ -0,0 +1,90 @@
+"""Предмет доказывания по категории дела (п. 5.4, 11.3 разбора).
+
+Для каждой категории дел положен перечень обстоятельств, подлежащих
+установлению. Система показывает судье таблицу: какое обстоятельство
+каким документом подтверждено, а какое — ничем. Это не вывод
+о правоте сторон, а карта доказательств: решение остаётся за судьёй.
+
+Первая категория — взыскание долга по договору (поставки, купли-продажи,
+возмездного оказания услуг): перечень из разбора рецензента. Обстоятельство
+считается освещённым, когда хотя бы один документ дела содержит маркер
+категории; этим документом и ссылается таблица. Нет ни одного —
+обстоятельство остаётся непроверенным, и это должно быть видно, а не
+спрятано за общими словами о «совокупности доказательств».
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from app.agents.evidence_pack import EvidenceItem
+
+
+@dataclass(frozen=True)
+class ProofFact:
+    """Одно обстоятельство предмета доказывания и его документы."""
+
+    circumstance: str
+    docs: tuple[str, ...]
+    covered: bool
+
+    def to_dict(self) -> dict[str, object]:
+        return {
+            "circumstance": self.circumstance,
+            "docs": list(self.docs),
+            "covered": self.covered,
+        }
+
+
+#: Перечень обстоятельств по взысканию задолженности по договору.
+#: Маркеры строчные — сверка идёт по тексту, приведённому к нижнему
+#: регистру. Обстоятельства взяты из предложенного рецензентом
+#: предмета доказывания (п. 5.4).
+DEBT_FACTS: tuple[tuple[str, tuple[str, ...]], ...] = (
+    (
+        "заключение договора",
+        ("договор", "соглашение", "контракт", "заключен"),
+    ),
+    (
+        "поставка товара / оказание услуг (документы об исполнении)",
+        ("накладн", "упд", "акт", "товарн", "счет-фактур", "отгрузк", "услуг"),
+    ),
+    (
+        "факт оплаты или неоплаты",
+        ("платежн", "перечислен", "оплат", "акт сверки", "задолженност", "долг"),
+    ),
+    (
+        "размер долга",
+        ("задолженност", "сумм", "цена", "стоимост", "руб"),
+    ),
+    (
+        "расчёт неустойки или процентов",
+        ("неустойк", "пен", "пени", "процент"),
+    ),
+)
+
+
+def subject_of_proof(items: list[EvidenceItem]) -> list[ProofFact]:
+    """Таблица «обстоятельство — доказательства» по материалам дела.
+
+    Документ считается упоминанием обстоятельства, когда маркер нашёлся
+    в тексте его фрагмента. По одному документу в списке источников не
+    повторяемся.
+    """
+    facts: list[ProofFact] = []
+    for circumstance, markers in DEBT_FACTS:
+        docs: list[str] = []
+        for item in items:
+            text = item.text.lower()
+            if any(marker in text for marker in markers) and (
+                item.source_document not in docs
+            ):
+                docs.append(item.source_document)
+        facts.append(
+            ProofFact(
+                circumstance=circumstance,
+                docs=tuple(docs),
+                covered=bool(docs),
+            )
+        )
+    return facts
diff --git a/backend/tests/test_subject_of_proof.py b/backend/tests/test_subject_of_proof.py
new file mode 100644
index 0000000..af8e9e4
--- /dev/null
+++ b/backend/tests/test_subject_of_proof.py
@@ -0,0 +1,63 @@
+"""Таблица «обстоятельство — доказательства» (п. 5.4 разбора)."""
+
+from app.agents.evidence_pack import EvidenceItem, EvidencePack
+from app.verification.engine import verify_draft
+from app.verification.subject_of_proof import subject_of_proof
+
+
+def _item(document: str, text: str, order: int) -> EvidenceItem:
+    return EvidenceItem(
+        category="evidence",
+        text=text,
+        source_document=document,
+        source_type="EVIDENCE",
+        order=order,
+    )
+
+
+class TestSubjectOfProof:
+    def test_covered_circumstance_lists_document(self) -> None:
+        pack = EvidencePack(case_number="T-1")
+        pack.items.append(_item("01_claim.txt", "Между сторонами заключён договор.", 1))
+        pack.items.append(_item("02_bill.txt", "Накладная на отгрузку товара.", 2))
+        facts = subject_of_proof(pack.items)
+        contract = facts[0]
+        assert contract.covered
+        assert contract.docs == ("01_claim.txt",)
+        delivery = facts[1]
+        assert delivery.docs == ("02_bill.txt",)
+
+    def test_uncovered_circumstance_reported(self) -> None:
+        facts = subject_of_proof(
+            [_item("01_claim.txt", "Истец просит взыскать долг.", 1)]
+        )
+        penalty = facts[-1]
+        assert not penalty.covered
+        assert not penalty.docs
+
+    def test_no_duplicate_documents(self) -> None:
+        pack = EvidencePack(case_number="T-2")
+        pack.items.append(
+            _item("01_claim.txt", "Договор от 5 марта 2013 года. Долг по договору.", 1)
+        )
+        facts = subject_of_proof(pack.items)
+        assert facts[0].docs == ("01_claim.txt",)
+        assert facts[2].docs == ("01_claim.txt",)
+
+    def test_report_serializes_facts(self) -> None:
+        pack = EvidencePack(case_number="T-3")
+        pack.items.append(_item("01_claim.txt", "Договор оставлен без оплаты.", 1))
+        draft = type("D", (), {})()
+        draft.sections = []
+        report = verify_draft(draft, pack)
+        data = report.to_dict()
+        assert len(data["subject_of_proof"]) == 5
+
+    def test_uncovered_facts_in_summary(self) -> None:
+        pack = EvidencePack(case_number="T-4")
+        draft = type("D", (), {})()
+        draft.sections = []
+        report = verify_draft(draft, pack)
+        summary = report.human_summary()
+        assert "Ни одним документом не подтверждено" in summary
+        assert "заключение договора" in summary
