Сквозной аудит суммировал только рубли, поэтому перенос копеек в рубли проходил незамеченным - теперь scripts/e2e_audit.py сверяет строку 'Всего подлежит взысканию' с суммой пунктов, пошлины и иных расходов с копейками. Первая же проверка нашла дефект: иные расходы по ст. 100 ГПК РФ жили внутри блока пошлины и в деле без пошлины (real-04) исчезали из проекта целиком и не попадали в итог (3 000). Теперь это отдельный пункт, real-04 показывает 32 692 руб. 90 коп. Suite 758/0, ruff, mypy чисто.
---
 backend/app/drafting/operative.py | 13 +++++++++++++
 docs/agent-summary.md             |  7 ++++++-
 docs/end-to-end-evaluation.md     | 14 ++++++++++++++
 scripts/build_real_site.py        |  9 ++++++++-
 scripts/e2e_audit.py              | 23 +++++++++++++++++++++++
 5 files changed, 64 insertions(+), 2 deletions(-)

diff --git a/backend/app/drafting/operative.py b/backend/app/drafting/operative.py
index 367e952..e75bafe 100644
--- a/backend/app/drafting/operative.py
+++ b/backend/app/drafting/operative.py
@@ -761,6 +761,19 @@ def build_operative(
             if costs is not None:
                 granted.append((costs, 0))
 
+    # Иные расходы по ст. 100 ГПК РФ не зависят от пошлины: их понёс
+    # истец, и суд возвращает их независимо от того, известна ли
+    # пошлина. Раньше пункт о них жил внутри блока пошлины, и в деле
+    # без пошлины (real-04) иные расходы исчезали из проекта целиком
+    # и не попадали в итог «а всего».
+    if costs is not None and not (fee_stakes and fee_paid is not None):
+        result.items.append(
+            f"Взыскать с {named.defendant_genitive} в пользу "
+            f"{named.plaintiff_genitive} иные расходы в размере "
+            f"{_amount(costs)} (ст. 100 ГПК РФ)."
+        )
+        granted.append((costs, 0))
+
     # 5. Итог «а всего». Так пишут в резолюции: одна цифра, из которой
     #    видно общий размер взыскания.
     if total_line and granted:
