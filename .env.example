# ─────────────────────────────────────────────────────────────────────────
# CourtDraft AI — конфигурация
#
# Единственное место, где живут различия между машинами (п.61 ТЗ).
# Скопируйте в .env и правьте под свою машину. Сам .env в git НЕ попадает.
#
#   DEVELOPMENT (ноутбук 8 GB, CPU only, без GPU):
#     LLM_PROVIDER=mock
#     EMBEDDING_PROVIDER=mock
#     OLLAMA_ENABLED=false
#
#   RUNTIME (компьютер с RTX 3050):
#     LLM_PROVIDER=ollama
#     EMBEDDING_PROVIDER=local
#     OLLAMA_ENABLED=true
#     OLLAMA_MODEL=qwen3.5:4b
#
# Переключение MOCK -> REAL не должно требовать правки кода.
# ─────────────────────────────────────────────────────────────────────────

# ── Приложение ────────────────────────────────────────────────────────────
APP_NAME=CourtDraft AI
APP_ENV=development          # development | runtime
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ── Режим ИИ (главный переключатель MOCK/REAL) ────────────────────────────
# mock | ollama
LLM_PROVIDER=mock
# mock | local
EMBEDDING_PROVIDER=mock

# ── Ollama (нужен только в RUNTIME) ───────────────────────────────────────
OLLAMA_ENABLED=false
# Из контейнера Docker к Ollama на хосте — так и оставить.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SEC=120
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.1
# Ollama не обязателен для старта backend: см. раздел EMBEDDINGS ниже.

# ── Embeddings ────────────────────────────────────────────────────────────
# Размерность вектора. Меняйте ОДНОВРЕМЕННО с моделью эмбеддингов.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=bge-m3
# Система обязана стартовать и без модели эмбеддингов, печатая
# "Embedding provider unavailable. System is running in degraded/mock mode."
EMBEDDINGS_OPTIONAL=true

# ── База данных ──────────────────────────────────────────────────────────
# Два диалекта, один код:
#   - development без PostgreSQL -> sqlite+aiosqlite (по умолчанию)
#   - runtime на RTX 3050         -> postgresql+asyncpg
#
# Если задать DATABASE_URL явно, он имеет приоритет над POSTGRES_*.
# Пока DATABASE_URL пуст, а POSTGRES_* равны значениям ниже, система
# выбирает SQLite — на ноутбуке PostgreSQL не установлен, а Docker
# недоступен, и падать при старте было бы хуже, чем работать на файле.
#
# Для PostgreSQL (после Фазы 3 на машине с БД):
#   DATABASE_URL=postgresql+asyncpg://courtdraft:courtdraft@localhost:5432/courtdraft
# Для SQLite явно:
#   DATABASE_URL=sqlite+aiosqlite:///./data/cases/courtdraft.db
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=courtdraft
POSTGRES_USER=courtdraft
POSTGRES_PASSWORD=courtdraft

# ── Qdrant ────────────────────────────────────────────────────────────────
# На ноутбуке используется встроенный режим (QDRANT_MODE=memory),
# чтобы не поднимать сервер. Сервер нужен только для RTX 3050.
QDRANT_MODE=memory           # memory | server
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_LAWS=legal_laws
QDRANT_COLLECTION_CASES=legal_cases
QDRANT_COLLECTION_DOCS=case_documents

# ── RAG ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATES=50
# Веса для Reciprocal Rank Fusion (п.25)
RRF_K=60

# ── Ограничения ресурсов (п.54 — консервативно для 8 GB RAM) ───────────────
MAX_UPLOAD_MB=50
EMBEDDING_BATCH_SIZE=16
CONCURRENCY_LIMIT=2
REQUEST_TIMEOUT_SEC=300

# ── Хранилище файлов ──────────────────────────────────────────────────────
# Пути относительны к корню репозитория (НЕ к текущему каталогу):
# запуск из backend/ не должен создавать data/ внутри backend/.
STORAGE_DIR=./data/cases
DOCUMENTS_DIR=./data/cases/documents
DEMO_DIR=./data/demo
LAWS_DIR=./data/laws
TEMPLATES_DIR=./data/templates

# ── CORS (только локально, п.44 LOCAL ONLY) ───────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Никаких внешних LLM/embedding API. Оставьте пустым — система обязана
# работать без интернета.

# ── Обезличивание (п.45) ──────────────────────────────────────────────────
PII_ANONYMIZE_DEMO=true

# ── Оценка качества (п.63) ────────────────────────────────────────────────
EVAL_CASES=20
EVAL_TOP_K=5
